APP_ENV=production
APP_URL=https://spfpu.example.uthm.edu.my
APP_KEY=replace-with-at-least-32-random-characters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spfpu
DB_USER=spfpu
DB_PASS=
SESSION_IDLE_SECONDS=28800
IMPORT_MAX_BYTES=5242880
BACKUP_BINARY=/usr/bin/mariadb-dump
# Windows/UniServerZ example: C:\UniServerZ\core\mysql\bin\mysqldump.exe

# Used once by: php bin/console seed:admin
SPFPU_ADMIN_NAME=
SPFPU_ADMIN_USERNAME=
SPFPU_ADMIN_EMAIL=
SPFPU_ADMIN_PASSWORD=
